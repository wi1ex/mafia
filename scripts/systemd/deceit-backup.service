[Unit]
Description=Back up Deceit once per day when no rooms exist
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root
StateDirectory=deceit-backup
StateDirectoryMode=0700
UMask=0077
Environment=TZ=Europe/Moscow
ExecStart=/usr/bin/bash -c 'if [ -d /root/deceit ]; then exec /usr/bin/bash /root/deceit/scripts/backup_when_idle.sh; elif [ -d /root/mafia ]; then exec /usr/bin/bash /root/mafia/scripts/backup_when_idle.sh; else echo "Neither /root/deceit nor /root/mafia exists" >&2; exit 1; fi'
TimeoutStartSec=infinity
